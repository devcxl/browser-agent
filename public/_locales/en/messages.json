  "home_title": {
    "message": "How can I help?"
  },
  "home_subtitle": {
    "message": "Manage tabs, windows and bookmarks in one sentence"
  },
  "home_sug1_title": {
    "message": "Organize tabs intelligently"
  },
  "home_sug1_desc": {
    "message": "Suggest groups based on purpose, task, and content relevance"
  },
  "home_sug1_prompt": {
    "message": "Analyze all tabs in the current window and propose sensible groups based on page purpose, task, and content relevance. Do not group solely by domain: different sites used for the same task may belong together, while pages from the same site may belong in different groups when their purposes differ. First list each suggested group, its tabs, and the reasoning. Wait for my confirmation before moving or grouping anything."
  },
  "home_sug2_title": {
    "message": "Find duplicate tabs"
  },
  "home_sug2_desc": {
    "message": "List tabs with duplicate URLs without closing them"
  },
  "home_sug2_prompt": {
    "message": "Find tabs with duplicate URLs in the current window and list their titles, URLs, and groups. Do not close any tabs yet."
  },
  "home_sug3_title": {
    "message": "Find sound sources"
  },
  "home_sug3_desc": {
    "message": "Find audible tabs without muting them"
  },
  "home_sug3_prompt": {
    "message": "Find tabs that are currently playing sound and list their titles, URLs, and windows. Do not mute, close, or switch tabs."
  },
  "home_sug4_title": {
    "message": "Recently closed"
  },
  "home_sug4_desc": {
    "message": "Review recently closed tabs and windows"
  },
  "home_sug4_prompt": {
    "message": "Review recently closed tabs and windows, ordered from most recently closed, and list their titles and URLs. Do not restore anything automatically."
  }
