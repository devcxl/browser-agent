{
  // 逐步把 src/entrypoints 纳入类型检查的第一步：先纳入已清零的侧边栏。
  // 主 tsconfig 仍排除整个 src/entrypoints（background / content 尚未清零），
  // 否则一处历史错误会挡住整个目录。
  //
  // include 必须显式列出 src/shared/browser.d.ts（手写的 browser 全局声明）：
  // 只列源码目录会把全局声明排除在外。刻意不列 .wxt/types/*.d.ts——
  // 那是 WXT 生成的另一套声明，与手写版对 getMessage 的签名不一致（重载冲突）。
  "extends": "./tsconfig.json",
  "include": [
    "src/entrypoints/sidepanel/**/*.ts",
    "src/entrypoints/sidepanel/**/*.tsx",
    "src/shared/browser.d.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/__tests__"]
}
